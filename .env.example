# Copia este archivo como .env y reemplaza los valores de ejemplo.
PORT=8084

# RabbitMQ (en docker-compose: amqp://hotel:<clave>@rabbitmq:5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=5
RABBITMQ_MAX_REINTENTOS=3
# Si cambias la espera después de crear las colas, borra hotel.*.retry o RabbitMQ rechazará la declaración.
RABBITMQ_ESPERA_REINTENTO_MS=5000

# MySQL: la cola de registro guarda una copia de cada reserva (tabla reporte_reservas) para el informe del admin.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hotel

# Dónde se guardan los PDF generados y el log de mensajes muertos.
DOCUMENTOS_DIR=./documentos
LOG_DIR=./logs

# SMTP opcional: si SMTP_HOST está vacío, los PDF solo se guardan en DOCUMENTOS_DIR.
# Con docker-compose se usa Mailpit (host mailpit, puerto 1025) y los correos se ven en http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=Hotel Valparaíso <no-reply@hotel.local>

# Demo de la cola que falla: si el admin pide el informe con un email que termina así, el aviso
# (hotel.reportes.aviso.queue) falla, se reintenta y termina en hotel.dlq -> listener error.
SIMULAR_FALLO_DOMINIO=@falla.test
